# Public configuration only. Never put client secrets or access tokens in VITE_*.
VITE_COGNITO_DOMAIN=https://YOUR-DOMAIN.auth.ap-southeast-1.amazoncognito.com
VITE_OWNER_CLIENT_ID=
VITE_VENUE_CLIENT_ID=
VITE_VENUE_API_URL=/api/venue
VITE_ITEM_API_URL=/api/item
VITE_MATCHING_API_URL=/api/matching
VITE_CLAIM_API_URL=/api/claim
# Local Vite proxy targets; change ports to match the backend processes.
# These DEV_* values are never bundled into the frontend.
DEV_VENUE_API_TARGET=http://127.0.0.1:8002
DEV_ITEM_API_TARGET=http://127.0.0.1:8003
DEV_MATCHING_API_TARGET=http://127.0.0.1:8005
DEV_CLAIM_API_TARGET=http://127.0.0.1:8004
# Deployed settings can be changed in public/config.json (or dist/config.json)
# without rebuilding. Only public URLs/client IDs belong there, never secrets.
