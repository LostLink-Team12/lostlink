SERVICE_NAME=notification-service
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://lostlink_notification_api:REPLACE_API_PASSWORD@localhost:5432/lostlink
# Optional operator API credential; omit to disable /v1/admin endpoints.
ADMIN_DATABASE_URL=postgresql+psycopg://lostlink_notification_admin:REPLACE_ADMIN_PASSWORD@localhost:5432/lostlink
# Inject only this credential into the consume/tasks worker processes.
# WORKER_DATABASE_URL=postgresql+psycopg://lostlink_notification_worker:REPLACE_WORKER_PASSWORD@localhost:5432/lostlink
# Use migration credentials only for Alembic, never in running API/worker containers.
# MIGRATION_DATABASE_URL=postgresql+psycopg://REPLACE_MIGRATOR:REPLACE_PASSWORD@localhost:5432/lostlink
NOTIFICATION_API_ROLE=lostlink_notification_api
NOTIFICATION_ADMIN_ROLE=lostlink_notification_admin
NOTIFICATION_WORKER_ROLE=lostlink_notification_worker
COGNITO_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/REPLACE_POOL
COGNITO_CLIENT_IDS=["owner-web","operations-console"]
USER_CLIENT_IDS=["owner-web"]
OPERATOR_CLIENT_IDS=["operations-console"]
AWS_REGION=ap-southeast-1
AWS_ENDPOINT_URL=http://localhost:4566
# Worker settings.
# EVENT_QUEUE_URL=http://localhost:4566/000000000000/notification-match-found
# MATCHING_BASE_URL=https://matching.internal.example
# MACHINE_TOKEN_URL=https://replace.auth.ap-southeast-1.amazoncognito.com/oauth2/token
# MACHINE_CLIENT_ID=notification-service
# MACHINE_CLIENT_SECRET=REPLACE_SECRET
# COGNITO_USER_POOL_ID=ap-southeast-1_REPLACE
# OWNER_APP_BASE_URL=https://app.lostlink.example
# EMAIL_SENDER=ses
# SES_FROM_ADDRESS=noreply@lostlink.example
# SES_CONFIGURATION_SET=lostlink-notifications
