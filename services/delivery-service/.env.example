SERVICE_NAME=delivery-service
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://lostlink_delivery_api:REPLACE_API_PASSWORD@localhost:5432/lostlink
# Inject only this credential into the separate consume/outbox worker processes.
# WORKER_DATABASE_URL=postgresql+psycopg://lostlink_delivery_worker:REPLACE_WORKER_PASSWORD@localhost:5432/lostlink
# Use migration credentials only for Alembic, never in running API/worker containers.
# MIGRATION_DATABASE_URL=postgresql+psycopg://REPLACE_MIGRATOR:REPLACE_PASSWORD@localhost:5432/lostlink
DELIVERY_API_ROLE=lostlink_delivery_api
DELIVERY_WORKER_ROLE=lostlink_delivery_worker
COGNITO_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/REPLACE_POOL
# Owner App (human) clients and courier partners (machine clients with lostlink/deliveries.update).
COGNITO_CLIENT_IDS=["owner-web","courier-demo"]
USER_CLIENT_IDS=["owner-web"]
PARTNER_CLIENT_IDS=["courier-demo"]
# JSON object of key ID to base64 32-byte key; protects delivery addresses at rest.
FIELD_ENCRYPTION_KEYS={"delivery-2026-10":"REPLACE_BASE64_32_BYTE_KEY"}
FIELD_ENCRYPTION_ACTIVE_KEY_ID=delivery-2026-10
AWS_REGION=ap-southeast-1
AWS_ENDPOINT_URL=http://localhost:4566
# consume: queue subscribed to claim.approved, claim.handed_over, claim.cancelled.
# EVENT_QUEUE_URL=http://localhost:4566/000000000000/delivery-events
# outbox: publishes delivery.status_changed to the shared topic.
# EVENT_TOPIC_ARN=arn:aws:sns:ap-southeast-1:000000000000:lostlink-domain-events
