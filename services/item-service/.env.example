SERVICE_NAME=item-service
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://lostlink_item_api:CHANGE_ME@localhost:5432/lostlink
INTERNAL_DATABASE_URL=postgresql+psycopg://lostlink_item_internal:CHANGE_ME@localhost:5432/lostlink
# Inject only this credential into the separate worker processes.
# WORKER_DATABASE_URL=postgresql+psycopg://lostlink_item_worker:CHANGE_ME@localhost:5432/lostlink
# Use migration credentials only for Alembic, never in running API/worker containers.
# MIGRATION_DATABASE_URL=postgresql+psycopg://migration_owner:CHANGE_ME@localhost:5432/lostlink
ITEM_API_ROLE=lostlink_item_api
ITEM_INTERNAL_ROLE=lostlink_item_internal
ITEM_WORKER_ROLE=lostlink_item_worker
COGNITO_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/REPLACE_POOL
COGNITO_CLIENT_IDS=["venue-web","claim-service","matching-service","embedding-worker"]
USER_CLIENT_IDS=["venue-web"]
CLAIM_CLIENT_IDS=["claim-service"]
INDEX_CLIENT_IDS=["matching-service","embedding-worker"]
VENUE_BASE_URL=https://venue.internal.example
MACHINE_TOKEN_URL=https://replace.auth.ap-southeast-1.amazoncognito.com/oauth2/token
MACHINE_CLIENT_ID=item-service
MACHINE_CLIENT_SECRET=REPLACE_SECRET
PHOTO_BUCKET=lostlink-item-photos-local
AWS_REGION=ap-southeast-1
AWS_ENDPOINT_URL=http://localhost:4566
# Workers read the same bucket but own their database credential.
# EVENT_TOPIC_ARN=arn:aws:sns:ap-southeast-1:000000000000:lostlink-domain-events
# EVENT_QUEUE_URL=http://localhost:4566/000000000000/item-embedding-results
