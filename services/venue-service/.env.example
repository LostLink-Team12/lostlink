SERVICE_NAME=venue-service
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://lostlink_venue_api:CHANGE_ME@localhost:5432/lostlink
PLATFORM_DATABASE_URL=postgresql+psycopg://lostlink_venue_platform:CHANGE_ME@localhost:5432/lostlink
# Workers and token triggers run separately. Inject only their own credential there.
# WORKER_DATABASE_URL=postgresql+psycopg://lostlink_venue_worker:CHANGE_ME@localhost:5432/lostlink
# IDENTITY_DATABASE_URL=postgresql+psycopg://lostlink_venue_identity:CHANGE_ME@localhost:5432/lostlink
# Run migrations separately; never inject migration credentials into an API container.
# MIGRATION_DATABASE_URL=postgresql+psycopg://migration_owner:CHANGE_ME@localhost:5432/lostlink
VENUE_API_ROLE=lostlink_venue_api
VENUE_PLATFORM_ROLE=lostlink_venue_platform
VENUE_WORKER_ROLE=lostlink_venue_worker
VENUE_IDENTITY_ROLE=lostlink_venue_identity
COGNITO_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/REPLACE_POOL
COGNITO_USER_POOL_ID=REPLACE_POOL
COGNITO_CLIENT_IDS=["venue-web","platform-ops","item-service","claim-service","identity-adapter"]
USER_CLIENT_IDS=["venue-web"]
PLATFORM_CLIENT_IDS=["platform-ops"]
MEMBER_CHECK_CLIENT_IDS=["item-service","claim-service"]
IDENTITY_RESOLVE_CLIENT_IDS=[]
AWS_REGION=ap-southeast-1
# AWS_ENDPOINT_URL=http://localhost:4566
# EVENT_TOPIC_ARN=arn:aws:sns:ap-southeast-1:000000000000:lostlink-domain-events
