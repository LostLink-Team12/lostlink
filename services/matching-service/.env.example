SERVICE_NAME=matching-service
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://lostlink_matching_api:replace-me@localhost:5432/lostlink
INTERNAL_DATABASE_URL=postgresql+psycopg://lostlink_matching_internal:replace-me@localhost:5432/lostlink
WORKER_DATABASE_URL=postgresql+psycopg://lostlink_matching_worker:replace-me@localhost:5432/lostlink
MIGRATION_DATABASE_URL=postgresql+psycopg://migration_user:replace-me@localhost:5432/lostlink
MATCHING_API_ROLE=lostlink_matching_api
MATCHING_INTERNAL_ROLE=lostlink_matching_internal
MATCHING_WORKER_ROLE=lostlink_matching_worker
COGNITO_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/replace-pool
COGNITO_CLIENT_IDS=["replace-web-client","replace-notification-client"]
USER_CLIENT_IDS=["replace-web-client"]
NOTIFICATION_CLIENT_IDS=["replace-notification-client"]
ITEM_BASE_URL=https://item.internal.example
MACHINE_TOKEN_URL=https://replace-domain.auth.ap-southeast-1.amazoncognito.com/oauth2/token
MACHINE_CLIENT_ID=replace-matching-machine-client
MACHINE_CLIENT_SECRET=replace-me
ITEM_PHOTO_BUCKETS=["replace-item-photo-bucket"]
CLIP_CHECKPOINT=/models/ViT-B-32.pt
# Required full SHA256 of a trusted checkpoint, never a mutable download URL.
CLIP_SHA256=40d365715913c9da98579312b702a82c18be219cc2a73407c4526f58eba950af
CLIP_DEVICE=cpu
# Calibrated cut-offs for automatic matches (reports with a photo / text-only reports).
MATCH_THRESHOLD=0.78
MATCH_THRESHOLD_TEXT=0.63
EVENT_TOPIC_ARN=arn:aws:sns:ap-southeast-1:000000000000:lostlink-events
EVENT_QUEUE_URL=http://localhost:4566/000000000000/matching-events
AWS_ENDPOINT_URL=http://localhost:4566
