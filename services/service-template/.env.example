SERVICE_NAME=service-template
ENVIRONMENT=local
LOG_LEVEL=INFO

# Local development only. Use distinct runtime/migration credentials in AWS.
DATABASE_URL=postgresql+psycopg://lostlink_app:local-development-only@localhost:5432/lostlink
MIGRATION_DATABASE_URL=postgresql+psycopg://lostlink:lostlink@localhost:5432/lostlink
DATABASE_APP_ROLE=lostlink_app

# Configure both values together. Access tokens must include custom:tenant_id
# for venue operations; ID tokens are never accepted.
# COGNITO_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/your-pool-id
# COGNITO_CLIENT_IDS=["your-venue-client-id","your-owner-client-id"]
# COGNITO_AUDIENCE=https://api.example.com

AWS_REGION=ap-southeast-1
AWS_ENDPOINT_URL=http://localhost:4566
# EVENT_TOPIC_ARN=arn:aws:sns:ap-southeast-1:000000000000:lostlink-events
# EVENT_QUEUE_URL=http://sqs.ap-southeast-1.localhost.localstack.cloud:4566/000000000000/lostlink-embedding
