SERVICE_NAME=claim-service
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://lostlink_claim_api:REPLACE_API_PASSWORD@localhost:5432/lostlink
# Inject only this credential into the separate worker processes.
# WORKER_DATABASE_URL=postgresql+psycopg://lostlink_claim_worker:REPLACE_WORKER_PASSWORD@localhost:5432/lostlink
# Use migration credentials only for Alembic, never in running API/worker containers.
# MIGRATION_DATABASE_URL=postgresql+psycopg://REPLACE_MIGRATOR:REPLACE_PASSWORD@localhost:5432/lostlink
CLAIM_API_ROLE=lostlink_claim_api
CLAIM_WORKER_ROLE=lostlink_claim_worker
COGNITO_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/REPLACE_POOL
COGNITO_CLIENT_IDS=["owner-web","venue-web"]
USER_CLIENT_IDS=["owner-web","venue-web"]
COGNITO_USER_POOL_ID=ap-southeast-1_REPLACE
VENUE_BASE_URL=https://venue.internal.example
ITEM_BASE_URL=https://item.internal.example
MACHINE_TOKEN_URL=https://replace.auth.ap-southeast-1.amazoncognito.com/oauth2/token
MACHINE_CLIENT_ID=claim-service
MACHINE_CLIENT_SECRET=REPLACE_SECRET
# JSON object of key ID to base64 32-byte key, from the secret store.
FIELD_ENCRYPTION_KEYS={"claim-2026-10":"REPLACE_BASE64_32_BYTE_KEY"}
FIELD_ENCRYPTION_ACTIVE_KEY_ID=claim-2026-10
# Base64 secret of at least 32 bytes used to hash QR handover codes.
HANDOVER_TOKEN_KEY=REPLACE_BASE64_32_BYTE_KEY
AWS_REGION=ap-southeast-1
AWS_ENDPOINT_URL=http://localhost:4566
# The outbox worker publishes to the shared topic.
# EVENT_TOPIC_ARN=arn:aws:sns:ap-southeast-1:000000000000:lostlink-domain-events
